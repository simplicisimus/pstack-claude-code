#!/usr/bin/env bash
# Writes pstack's fixed-effort agents, one per effort level for each of reviewer.md and poteto-agent.md.
# A copy keeps its base's body and frontmatter, and sets its own name, a one-line description, and effort.
# It sets no model, because the Agent call passes one.
#
#   tools/gen-effort-agents          rewrite pstack/agents/<base>-<effort>.md
#   tools/gen-effort-agents --check  exit 1 when a copy differs from what it would write
set -eu

agents=$(cd "$(dirname "$0")/../pstack/agents" && pwd)
check=0
case "${1-}" in
--check) check=1 ;;
"") ;;
*)
	echo "usage: tools/gen-effort-agents [--check]" >&2
	exit 2
	;;
esac

render() {
	awk -v base="$1" -v effort="$2" '
		NR == 1 {
			if ($0 != "---") {
				print FILENAME ": no frontmatter" > "/dev/stderr"
				exit 1
			}
			print
			print "# Generated by tools/gen-effort-agents from " base ".md. Edit " base ".md and rerun the script."
			print "name: " base "-" effort
			print "description: Only pstack skills spawn this agent."
			print "effort: " effort
			front = 1
			next
		}
		front && $0 == "---" { front = 0 }
		front && /^[A-Za-z]/ {
			key = $0
			sub(/:.*/, "", key)
			drop = key ~ /^(name|description|model|effort)$/
		}
		!(front && drop)
	' "$agents/$1.md"
}

stale=0
for base in reviewer poteto-agent; do
	for effort in low medium high xhigh max; do
		file="$agents/$base-$effort.md"
		if [ "$check" -eq 0 ]; then
			render "$base" "$effort" >"$file"
		elif ! render "$base" "$effort" | cmp -s - "$file"; then
			echo "pstack/agents/$base-$effort.md is out of date. Run tools/gen-effort-agents." >&2
			stale=1
		fi
	done
done
exit "$stale"
